# Energy Research Agent configuration
# Copy this file to .env. Never commit the populated .env file.

# Docker database (required only for docker compose)
POSTGRES_PASSWORD=

# Agent execution mode: orchestrating for real research; synthetic for offline smoke tests
ERA_AUTOMATION_EXECUTOR=orchestrating
ERA_INTELLIGENCE_CATCHUP=off
ERA_EXPORT_PATH=./outputs

# Primary/fallback LLM gateway (configure at least one provider for real research)
ERA_PRIMARY_MODEL=deepseek-chat
ERA_FALLBACK_MODEL=gpt-5
ERA_DEEPSEEK_API_KEY=
ERA_DEEPSEEK_API_BASE=https://api.deepseek.com
ERA_OPENAI_API_KEY=
ERA_OPENAI_API_BASE=https://api.openai.com/v1

# Optional dedicated vision endpoint; otherwise the Agent reuses an available LLM provider
ERA_VISION_API_KEY=
ERA_VISION_API_BASE=https://api.deepseek.com

# Research adapters
ERA_ANYSEARCH_API_KEY=
ERA_KIMI_WEB_SESSION=default
# Local Python runtime: the daemon normally listens on this machine.
ERA_KIMI_WEB_DAEMON_URL=http://127.0.0.1:10086
# Docker runtime: leave empty for host.docker.internal:10086, or set another
# URL that is reachable from inside the research-api container.
ERA_DOCKER_KIMI_WEB_DAEMON_URL=

# Optional process-local outbound proxy, for example http://127.0.0.1:7897
ERA_OUTBOUND_PROXY=

# Optional Feishu delivery
ERA_FEISHU_APP_ID=
ERA_FEISHU_APP_SECRET=
ERA_FEISHU_DEFAULT_RECEIVER=

# Optional local browser executable; Docker already provides Chromium
ERA_CHROME_PATH=
