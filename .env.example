# Copy to .env and replace with a strong value; never commit the real secret.
POSTGRES_PASSWORD=replace-with-a-strong-random-password
EER_DEEPSEEK_API_KEY=
EER_FEISHU_APP_ID=
EER_FEISHU_APP_SECRET=
EER_FEISHU_DEFAULT_RECEIVER=

# 可视化系统：diagram-design（MIT，第三方声明见 third_party/diagram-design/）。
# 图表由 Visual Router 语义路由 + DiagramDesignAdapter 确定性渲染，无商业授权开关。
# 图片像素级核验复用研究网关凭据，优先 DeepSeek-V4-Flash-Vision-Exp
# （EER_DEEPSEEK_API_KEY，每张图最多折算 384 token、与 V4-Flash 同价）；
# 也可用独立视觉端点覆盖（OpenAI 兼容 /chat/completions）。未配置任何视觉能力时，
# 图片不进入像素级核验，不会发布为实体配图（诚实降级，绝不冒充）。
ENTERPRISE_VISION_ENDPOINT=
ENTERPRISE_VISION_KEY=
ENTERPRISE_VISION_MODEL=
# Optional explicit Chrome/Chromium executable. The Docker image installs /usr/bin/chromium.
EER_CHROME_PATH=
