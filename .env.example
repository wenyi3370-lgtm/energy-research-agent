EER_PRIMARY_PROVIDER=deepseek
EER_FALLBACK_PROVIDER=openai
EER_PRIMARY_MODEL=deepseek-chat
EER_FALLBACK_MODEL=gpt-5
EER_DEEPSEEK_API_BASE=https://api.deepseek.com
EER_DEEPSEEK_API_KEY=
EER_OPENAI_API_BASE=
EER_OPENAI_API_KEY=
EER_DATABASE_URL=

# --- Automation API (Phase 2) ---
# 自动化控制面数据库（dev 可用 sqlite:///./automation.db，生产用 PostgreSQL）
EER_AUTOMATION_DATABASE_URL=sqlite:///./automation.db
# 研究/evidence 工作目录
EER_AUTOMATION_WORKDIR=automation_work
# 运行模式：synthetic（默认，零配置离线合成）| orchestrating（真实研究编排）
EER_AUTOMATION_EXECUTOR=synthetic

# --- 真实研究编排（编排接线，orchestrating 模式需要） ---
# Kimi WebBridge 浏览器会话名（daemon 需在本机运行并连接浏览器扩展）
EER_KIMI_WEB_SESSION=default

# --- Feishu / Lark (Phase 7) ---
# 未配置时通知自动 fail-closed（不发送且记录日志），研究流程不受影响
EER_FEISHU_APP_ID=
EER_FEISHU_APP_SECRET=
EER_FEISHU_DEFAULT_RECEIVER=
