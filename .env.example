# Copy to .env and replace with a strong value; never commit the real secret.
POSTGRES_PASSWORD=replace-with-a-strong-random-password
EER_DEEPSEEK_API_KEY=
EER_FEISHU_APP_ID=
EER_FEISHU_APP_SECRET=
EER_FEISHU_DEFAULT_RECEIVER=

# Lieflat Charts is PolyForm Noncommercial 1.0.0 unless separately licensed.
# Local evaluation/noncommercial use works with both values left false.
EER_LIEFLAT_COMMERCIAL_USE=false
EER_LIEFLAT_COMMERCIAL_LICENSED=false
# Optional explicit Chrome/Chromium executable. The Docker image installs /usr/bin/chromium.
EER_CHROME_PATH=
