{
  "$defs": {
    "ValueClass": {
      "description": "Unified evidence value class (Agent integration, §19).\n\nSuperset of the overseas market skill's ledger vocabulary:\nobserved -> OBSERVED, derived -> DERIVED, modeled_estimate -> MODEL_ESTIMATE,\nsimulated -> SIMULATED, scenario_assumption -> ASSUMPTION,\npending_verification -> TO_BE_CONFIRMED.",
      "enum": [
        "OBSERVED",
        "DERIVED",
        "MODEL_ESTIMATE",
        "SIMULATED",
        "ASSUMPTION",
        "TO_BE_CONFIRMED"
      ],
      "title": "ValueClass",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "CONFLICTING",
        "REJECTED",
        "STALE",
        "REVIEW_REQUIRED"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "field_name": {
      "minLength": 1,
      "title": "Field Name",
      "type": "string"
    },
    "raw_field_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Field Name"
    },
    "value": {
      "default": null,
      "title": "Value"
    },
    "value_type": {
      "title": "Value Type",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "as_of_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of Date"
    },
    "period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period Start"
    },
    "period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period End"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "qualifier": {
      "default": "unknown",
      "enum": [
        "exact",
        "approximately",
        "at_least",
        "at_most",
        "range",
        "unknown"
      ],
      "title": "Qualifier",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "raw_text": {
      "minLength": 1,
      "title": "Raw Text",
      "type": "string"
    },
    "context_text": {
      "minLength": 1,
      "title": "Context Text",
      "type": "string"
    },
    "locator": {
      "additionalProperties": true,
      "title": "Locator",
      "type": "object"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
