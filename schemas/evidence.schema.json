{
  "$defs": {
    "VerificationStatus": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "CONFLICTING",
        "REJECTED",
        "STALE",
        "REVIEW_REQUIRED"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "field_name": {
      "minLength": 1,
      "title": "Field Name",
      "type": "string"
    },
    "value": {
      "default": null,
      "title": "Value"
    },
    "value_type": {
      "title": "Value Type",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "as_of_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of Date"
    },
    "period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period Start"
    },
    "period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period End"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "qualifier": {
      "default": "unknown",
      "enum": [
        "exact",
        "approximately",
        "at_least",
        "at_most",
        "range",
        "unknown"
      ],
      "title": "Qualifier",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "raw_text": {
      "minLength": 1,
      "title": "Raw Text",
      "type": "string"
    },
    "context_text": {
      "minLength": 1,
      "title": "Context Text",
      "type": "string"
    },
    "locator": {
      "additionalProperties": true,
      "title": "Locator",
      "type": "object"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "verification_status": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "UNVERIFIED"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "conflict_group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conflict Group Id"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "claim_id",
    "entity_id",
    "field_name",
    "value_type",
    "source_id",
    "raw_text",
    "context_text",
    "confidence"
  ],
  "title": "Claim",
  "type": "object"
}
