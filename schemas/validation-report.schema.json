{
  "$defs": {
    "Severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "BLOCKER"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "validator": {
          "title": "Validator",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "actual": {
          "default": null,
          "title": "Actual"
        },
        "remediation": {
          "title": "Remediation",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "validator",
        "severity",
        "code",
        "message",
        "remediation"
      ],
      "title": "ValidationFinding",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "BLOCKED"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "validation_report_id": {
      "title": "Validation Report Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "freeze_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freeze Id"
    },
    "status": {
      "$ref": "#/$defs/ValidationStatus"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ValidationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "validation_report_id",
    "run_id",
    "status"
  ],
  "title": "ValidationReport",
  "type": "object"
}
