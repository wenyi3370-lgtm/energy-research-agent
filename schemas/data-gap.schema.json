{
  "$defs": {
    "GapStatus": {
      "enum": [
        "OPEN",
        "ACCEPTED",
        "RESOLVED",
        "BLOCKING"
      ],
      "title": "GapStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gap_id": {
      "title": "Gap Id",
      "type": "string"
    },
    "entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
