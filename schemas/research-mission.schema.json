{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "GoalClass": {
      "enum": [
        "CORE_ENTERPRISE",
        "CUSTOM_ENTERPRISE",
        "MARKET",
        "POLICY",
        "COMPETITION",
        "CHANNEL",
        "CUSTOMER",
        "PRODUCT",
        "ENGINEERING",
        "ECONOMICS",
        "STRATEGY",
        "CUSTOM"
      ],
      "title": "GoalClass",
      "type": "string"
    },
    "GoalStatus": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "PARTIAL",
        "SATISFIED",
        "BLOCKED",
        "EXHAUSTED"
      ],
      "title": "GoalStatus",
      "type": "string"
    },
    "MissionStatus": {
      "enum": [
        "PARSED",
        "PLANNED",
        "ROUTED",
        "AWAITING_APPROVAL",
        "APPROVED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "BLOCKED",
        "EXHAUSTED",
        "FAILED"
      ],
      "title": "MissionStatus",
      "type": "string"
    },
    "PriorityLevel": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "PriorityLevel",
      "type": "string"
    },
    "ResearchGoal": {
      "additionalProperties": false,
      "description": "One bounded research question (§9). Dynamic/custom goals are first-class.",
      "properties": {
        "goal_id": {
          "title": "Goal Id",
          "type": "string"
        },
        "goal_name": {
          "minLength": 1,
          "title": "Goal Name",
          "type": "string"
        },
        "goal_description": {
          "minLength": 1,
          "title": "Goal Description",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "subject_name": {
          "minLength": 1,
          "title": "Subject Name",
          "type": "string"
        },
        "subject_type": {
          "$ref": "#/$defs/SubjectType",
          "default": "enterprise"
        },
        "goal_class": {
          "$ref": "#/$defs/GoalClass"
        },
        "scope": {
          "additionalProperties": true,
          "title": "Scope",
          "type": "object"
        },
        "priority": {
          "$ref": "#/$defs/PriorityLevel",
          "default": "P2"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Success Criteria",
          "type": "array"
        },
        "assigned_skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/GoalStatus",
          "default": "PLANNED"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "gap_refs": {
          "items": {
            "type": "string"
          },
          "title": "Gap Refs",
          "type": "array"
        },
        "recovery_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Recovery Rounds",
          "type": "integer"
        },
        "routing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Routing Reason"
        }
      },
      "required": [
        "goal_id",
        "goal_name",
        "goal_description",
        "subject_id",
        "subject_name",
        "goal_class"
      ],
      "title": "ResearchGoal",
      "type": "object"
    },
    "ResearchMode": {
      "enum": [
        "ENTERPRISE",
        "MARKET",
        "HYBRID"
      ],
      "title": "ResearchMode",
      "type": "string"
    },
    "SkillName": {
      "enum": [
        "ENTERPRISE_RESEARCH",
        "OVERSEAS_MARKET_RESEARCH"
      ],
      "title": "SkillName",
      "type": "string"
    },
    "SubjectType": {
      "enum": [
        "enterprise",
        "market",
        "product",
        "custom"
      ],
      "title": "SubjectType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Top-level mission object (§8). The raw natural-language request is kept verbatim.",
  "properties": {
    "mission_id": {
      "title": "Mission Id",
      "type": "string"
    },
    "raw_request": {
      "minLength": 1,
      "title": "Raw Request",
      "type": "string"
    },
    "request_type": {
      "default": "research",
      "title": "Request Type",
      "type": "string"
    },
    "primary_subject": {
      "default": "",
      "description": "Free-text subject; resolved later to a canonical id",
      "title": "Primary Subject",
      "type": "string"
    },
    "canonical_entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Entity Id"
    },
    "geographies": {
      "items": {
        "type": "string"
      },
      "title": "Geographies",
      "type": "array"
    },
    "industries": {
      "items": {
        "type": "string"
      },
      "title": "Industries",
      "type": "array"
    },
    "products": {
      "items": {
        "type": "string"
      },
      "title": "Products",
      "type": "array"
    },
    "time_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Scope"
    },
    "decision_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Question"
    },
    "audience": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audience"
    },
    "mode": {
      "$ref": "#/$defs/ResearchMode",
      "default": "ENTERPRISE"
    },
    "goals": {
      "items": {
        "$ref": "#/$defs/ResearchGoal"
      },
      "title": "Goals",
      "type": "array"
    },
    "approval_status": {
      "$ref": "#/$defs/ApprovalStatus",
      "default": "PENDING"
    },
    "evidence_version": {
      "default": 1,
      "minimum": 1,
      "title": "Evidence Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/MissionStatus",
      "default": "PARSED"
    },
    "parse_mode": {
      "default": "llm",
      "title": "Parse Mode",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "mission_id",
    "raw_request"
  ],
  "title": "ResearchMission",
  "type": "object"
}
